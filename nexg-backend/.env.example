# Copy to .env — never commit .env
PORT=3000
DATABASE_URL=postgres://nexg:nexg_dev_password@localhost:5433/nexg
JWT_SECRET=change-me-dev-only-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Dev-only owner/admin provisioning key for POST /auth/accounts (x-bootstrap-key header).
# Never set in production; provision owners via an admin account instead.
ADMIN_BOOTSTRAP_KEY=nexg-dev-bootstrap
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexg-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_URL=http://localhost:9000/nexg-media
EXPO_PUBLIC_API_URL=http://localhost:3000
